# Copy to .env and adjust. Every value below is accepted as-is by internal/config.

# App
APP_NAME=Clean Go Fiber
APP_PORT=3000
# development | staging | production
APP_ENV=development
APP_TIMEZONE=UTC
# info | warn | debug
LOG_LEVEL=info
# Serves /docs and /docs/openapi.json. Keep false everywhere except local development.
ENABLE_API_DOCS=true

# Front-end base URL used in verification and reset links
CLIENT_URL=http://localhost:3000

# Database (local). docker compose overrides DATABASE_URL to use the "postgres" service host.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/clean_go?sslmode=disable
POSTGRES_DB=clean_go
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis (local). docker compose overrides REDIS_HOST to "redis".
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Mail (only the worker sends mail)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_FROM=Clean Go Fiber <no-reply@example.com>
MAIL_USER=your_email@example.com
MAIL_PASS=your_email_password

# JWT - both required and must differ. Generate each with: openssl rand -hex 32
JWT_SECRET=change-me-before-running
JWT_REFRESH_SECRET=change-me-too-before-running

# CORS: empty allows every origin; otherwise a comma-separated list of origins
ALLOWED_HOST=
